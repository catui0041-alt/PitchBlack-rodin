# Recovery init additions for rodin (MediaTek MT6899).
#
# The USB properties below are the ones the stock recovery ramdisk sets, read
# from this device's own vendor_boot: without them adb/fastbootd do not come up
# in recovery. Everything else stays minimal on purpose, because a mistake here
# is a boot failure rather than a cosmetic bug.

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"

on early-init
    mkdir /data 0771 system system

on boot
    mkdir /tmp 0777 root root
    mkdir /cache 0771 system cache
